--- a/terraform/dependencies.tf
+++ b/terraform/dependencies.tf
@@ -10,6 +10,12 @@ data "terraform_remote_state" "dynamodb" {
   }
 }

+# New dependency on the platform DynamoDB module to back the
+# capability's session store.
+module "session_store" {
+  source = "github.com/i-dot-ai/i-dot-ai-core-terraform-modules//modules/dynamodb"
+  table_name = "${local.name}-sessions"
+}
+
 resource "aws_iam_policy" "session_store_read" {
   name = "${local.name}-session-store-read"
   policy = data.aws_iam_policy_document.session_store_read.json
